# Vercel CLI uploads files that are not in .vercelignore, even when they are
# gitignored. `includeFiles: backend/**` would otherwise be able to bundle the
# local .env (secrets), .venv, and the dev SQLite DB into the function.
.env
.env.*
backend/.env
backend/.env.*
backend/.venv
backend/**/__pycache__
**/*.db
**/*.sqlite3
frontend/node_modules
frontend/dist
