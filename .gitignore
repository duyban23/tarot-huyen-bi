# ── Node ──
node_modules/
frontend/node_modules/

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
backend/.venv/

# ── Build output ──
frontend/dist/
*.db
*.sqlite3

# ── Environment ──
# Secrets live in Vercel project settings, never in the repo.
# `vercel env pull` writes .env.production.local / .vercel/.env.*.local,
# which the old explicit list did not cover.
.env
.env.*
!.env.example
!.env.*.example
backend/.env
frontend/.env

# ── OS ──
.DS_Store
Thumbs.db

# ── IDE ──
.vscode/
.idea/

# ── Docker (reference only, keep compose for docs) ──
docker-compose.override.yml

# ── Vercel ──
.vercel/

# `vercel build` generates these from requirements.txt. Do not commit them:
# a root pyproject.toml would take precedence over requirements.txt on Vercel
# and pin a different Python/dep set than the lambda actually ships.
pyproject.toml
uv.lock

# ── Misc ──
*.log
PLAN_NOTES.md
scripts/.tmp-*/
