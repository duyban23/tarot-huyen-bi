# Local dev: uvicorn trực tiếp trên máy -> dùng localhost.
# Khi chạy `docker compose up`, compose sẽ override bằng host `postgres`
# (xem docker-compose.yml) nên không cần sửa gì thêm.
# Khi có Neon mới: thay bằng postgresql+psycopg2://user:pass@ep-xxx-pooler...neon.tech/db?sslmode=require
DATABASE_URL=postgresql+psycopg2://tarot_user:tarot_pass@localhost:5432/tarot_db
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SECRET_KEY=change-this-to-a-random-secret-key-in-production
# Production: SECRET_KEY phải là chuỗi random >= 32 ký tự, không dùng giá trị mẫu.
# App sẽ từ chối khởi động trên Vercel production nếu vẫn là placeholder/ngắn.
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# --- Xem cùng My (AI + SePay, demo local) ---
# Gemini API key (https://aistudio.google.com). Để trống = AI trả lời "đang chuẩn bị".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Giữ dưới 60s (Vercel maxDuration); mặc định 50s.
GEMINI_TIMEOUT_SECONDS=50
AI_FREE_PER_DAY=5
# Tự xoá bản xem AI cũ hơn số ngày này (tránh giữ tên/ngày sinh mãi mãi).
AI_READING_RETENTION_DAYS=90
# SePay webhook secret (dashboard SePay → webhook → auth). Để trống = demo, chấp nhận mọi webhook local.
SEPAY_WEBHOOK_SECRET=
# Tài khoản nhận tiền sinh VietQR (DEMO trước, STK thật khi lên production).
SEPAY_BANK=MB
SEPAY_ACCOUNT=0343993456
SEPAY_ACCOUNT_NAME=HEALING WITH MY
PAYMENT_CODE_PREFIX=HWM

# Generate ADMIN_PASSWORD_HASH with (run from the repo root):
# python -c "import sys; sys.path.insert(0, 'backend'); from app.auth import hash_password; print(hash_password('your-password'))"
